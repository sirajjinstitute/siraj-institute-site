{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 .github/scripts/verify_asset_hashes.py . && python3 .github/scripts/scan_secrets.py . && python3 .github/scripts/build_site.py .",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|android-chrome-192x192.png|android-chrome-512x512.png|logo.png|site.webmanifest|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), midi=(), serial=(), bluetooth=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' https://*.googletagmanager.com; style-src 'self'; font-src 'self'; manifest-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), midi=(), serial=(), bluetooth=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' https://*.googletagmanager.com; style-src 'self'; font-src 'self'; manifest-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/:section(login|apply|jobapp|trial|admin|coordinator|supervisor|teacher|student|guardian|api)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "https://app.suqyainstitute.com/login",
      "statusCode": 308
    },
    {
      "source": "/login/:path*",
      "destination": "https://app.suqyainstitute.com/login/:path*",
      "statusCode": 308
    },
    {
      "source": "/admin",
      "destination": "https://app.suqyainstitute.com/admin",
      "statusCode": 308
    },
    {
      "source": "/admin/:path*",
      "destination": "https://app.suqyainstitute.com/admin/:path*",
      "statusCode": 308
    },
    {
      "source": "/coordinator",
      "destination": "https://app.suqyainstitute.com/coordinator",
      "statusCode": 308
    },
    {
      "source": "/coordinator/:path*",
      "destination": "https://app.suqyainstitute.com/coordinator/:path*",
      "statusCode": 308
    },
    {
      "source": "/supervisor",
      "destination": "https://app.suqyainstitute.com/supervisor",
      "statusCode": 308
    },
    {
      "source": "/supervisor/:path*",
      "destination": "https://app.suqyainstitute.com/supervisor/:path*",
      "statusCode": 308
    },
    {
      "source": "/teacher",
      "destination": "https://app.suqyainstitute.com/teacher",
      "statusCode": 308
    },
    {
      "source": "/teacher/:path*",
      "destination": "https://app.suqyainstitute.com/teacher/:path*",
      "statusCode": 308
    },
    {
      "source": "/student",
      "destination": "https://app.suqyainstitute.com/student",
      "statusCode": 308
    },
    {
      "source": "/student/:path*",
      "destination": "https://app.suqyainstitute.com/student/:path*",
      "statusCode": 308
    },
    {
      "source": "/guardian",
      "destination": "https://app.suqyainstitute.com/guardian",
      "statusCode": 308
    },
    {
      "source": "/guardian/:path*",
      "destination": "https://app.suqyainstitute.com/guardian/:path*",
      "statusCode": 308
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sirajinst.com"
        }
      ],
      "destination": "https://suqyainstitute.com/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sirajinst.com"
        }
      ],
      "destination": "https://suqyainstitute.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sirajinst.com"
        }
      ],
      "destination": "https://suqyainstitute.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sirajinst.com"
        }
      ],
      "destination": "https://suqyainstitute.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.suqyainstitute.com"
        }
      ],
      "destination": "https://suqyainstitute.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/apply",
      "destination": "https://siraj-lms.vercel.app/apply"
    },
    {
      "source": "/apply/:path*",
      "destination": "https://siraj-lms.vercel.app/apply/:path*"
    },
    {
      "source": "/jobapp",
      "destination": "https://siraj-lms.vercel.app/jobapp"
    },
    {
      "source": "/jobapp/:path*",
      "destination": "https://siraj-lms.vercel.app/jobapp/:path*"
    },
    {
      "source": "/trial",
      "destination": "https://siraj-lms.vercel.app/trial"
    },
    {
      "source": "/trial/:path*",
      "destination": "https://siraj-lms.vercel.app/trial/:path*"
    },
    {
      "source": "/api",
      "destination": "https://siraj-lms.vercel.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://siraj-lms.vercel.app/api/:path*"
    },
    {
      "source": "/app-icons/:path*",
      "destination": "https://siraj-lms.vercel.app/app-icons/:path*"
    },
    {
      "source": "/_next",
      "destination": "https://siraj-lms.vercel.app/_next"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://siraj-lms.vercel.app/_next/:path*"
    },
    {
      "source": "/brand",
      "destination": "https://siraj-lms.vercel.app/brand"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://siraj-lms.vercel.app/brand/:path*"
    },
    {
      "source": "/curriculum",
      "destination": "https://siraj-lms.vercel.app/curriculum"
    },
    {
      "source": "/curriculum/:path*",
      "destination": "https://siraj-lms.vercel.app/curriculum/:path*"
    }
  ]
}
