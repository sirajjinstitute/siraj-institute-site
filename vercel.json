{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|android-chrome-192x192.png|android-chrome-512x512.png|logo.png|site.webmanifest|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), midi=(), serial=(), bluetooth=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; font-src 'self'; img-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://siraj-lms.vercel.app https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), midi=(), serial=(), bluetooth=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; font-src 'self'; img-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://siraj-lms.vercel.app https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com"
        }
      ]
    },
    {
      "source": "/:section(login|apply|trial|admin|coordinator|supervisor|teacher|student|guardian|api)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login/:path*",
      "destination": "https://siraj-lms.vercel.app/login/:path*"
    },
    {
      "source": "/apply/:path*",
      "destination": "https://siraj-lms.vercel.app/apply/:path*"
    },
    {
      "source": "/trial/:path*",
      "destination": "https://siraj-lms.vercel.app/trial/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://siraj-lms.vercel.app/admin/:path*"
    },
    {
      "source": "/coordinator/:path*",
      "destination": "https://siraj-lms.vercel.app/coordinator/:path*"
    },
    {
      "source": "/supervisor/:path*",
      "destination": "https://siraj-lms.vercel.app/supervisor/:path*"
    },
    {
      "source": "/teacher/:path*",
      "destination": "https://siraj-lms.vercel.app/teacher/:path*"
    },
    {
      "source": "/student/:path*",
      "destination": "https://siraj-lms.vercel.app/student/:path*"
    },
    {
      "source": "/guardian/:path*",
      "destination": "https://siraj-lms.vercel.app/guardian/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://siraj-lms.vercel.app/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://siraj-lms.vercel.app/_next/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://siraj-lms.vercel.app/brand/:path*"
    },
    {
      "source": "/curriculum/:path*",
      "destination": "https://siraj-lms.vercel.app/curriculum/:path*"
    }
  ]
}
